// Viralyz data model — see BACKEND.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  clerkUserId      String?   @unique
  email            String    @unique
  passwordHash     String?
  name             String
  handle           String?   @unique
  avatarUrl        String?
  plan             String    @default("credits") // credits | unlimited
  role             String    @default("user") // user | admin
  emailVerifiedAt  DateTime?
  inviteCodeUsed   String?
  onboardingDone   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  platforms    Platform[]
  resetTokens  PasswordResetToken[]
  creditLedger CreditLedger[]
  brand        Brand?
  references   Reference[]
  creatives    Creative[]
  imports      PerformanceImport[]

  @@index([createdAt])
  @@index([role])
}

model Platform {
  id                String    @id @default(cuid())
  userId            String
  provider          String // tiktok | instagram | youtube
  handle            String
  externalAccountId String?
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scopes            String?
  connectedAt       DateTime  @default(now())
  syncStatus        String    @default("ok") // ok | syncing | error
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, handle])
  @@index([userId])
  @@index([provider])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  email     String?
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  createdBy String?
  note      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  status     String   @default("pending") // pending | approved | rejected
  note       String?
  inviteCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only. A user's credit balance is always the sum of their deltas —
/// never a mutable column. kind: grant | reserve | settle | refund | adjust.
/// refId ties reserve/settle/refund rows to the thing they're for (typically
/// a Creative id); @@unique([refId, kind]) keeps settle/refund idempotent —
/// a second attempt collides instead of double-crediting or double-debiting.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  kind      String // grant | reserve | settle | refund | adjust
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([refId, kind])
  @@index([userId])
}

/// One per account. No generation runs without a confirmed Brand.
model Brand {
  id          String    @id @default(cuid())
  userId      String    @unique
  name        String
  sourceUrl   String?
  colors      Json // string[] of hex colors
  logoUrl     String?
  voice       String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  creatives Creative[]

  @@index([userId])
}

model Product {
  id        String   @id @default(cuid())
  brandId   String
  title     String
  price     Decimal? @db.Decimal(10, 2)
  currency  String?
  imageUrls Json // string[]
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creatives Creative[]

  @@index([brandId])
}

/// userId is null for Tier 1 (official, ingested) references — those are a
/// shared catalog, not owned by any one account. It's set for Tier 2 ("Yours":
/// a pasted URL or an upload). Deliberately no DB-level uniqueness on
/// (source, sourceRef): idempotent re-ingestion (Task 6) and per-user dedup
/// of a pasted URL (Task 5) are two different rules — the former ignores
/// userId, the latter is scoped to it — so each is enforced in application
/// code rather than forced into one constraint that would get either wrong.
model Reference {
  id           String    @id @default(cuid())
  userId       String?
  source       String // meta_eu_uk | tiktok_ccl | user_url | user_upload | vendor
  sourceRef    String // external id or URL
  advertiser   String?
  category     String? // product/vertical category, for Discover filtering
  firstSeenAt  DateTime?
  lastSeenAt   DateTime?
  daysRunning  Int?
  variantCount Int?
  country      String?
  structure    Json? // { hookType, layout, offerType, cta, model }
  thumbnailUrl String?
  fetchedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatives Creative[]

  @@index([userId])
  @@index([source, sourceRef])
}

model Creative {
  id            String   @id @default(cuid())
  userId        String
  brandId       String
  productId     String
  referenceId   String?
  placement     String // meta_feed_1x1 | meta_feed_4x5 | story_9x16 | tiktok_9x16
  angle         String // offer | problem | proof | demo
  headline      String?
  primaryText   String?
  cta           String?
  backgroundKey String?
  backgroundUrl String?
  compositeKey  String?
  compositeUrl  String?
  tag           String   @unique // vz_<4 lowercase base36 chars>
  aiGenerated   Boolean  @default(true)
  status        String   @default("pending") // pending | generating | ready | failed
  provider      String?
  providerModel String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  reference       Reference?       @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  checks          Check[]
  performanceRows PerformanceRow[]

  @@index([userId])
  @@index([status])
}

model Check {
  id            String   @id @default(cuid())
  creativeId    String
  checkVersion  Int
  factors       Json // FactorResult[]
  headline      Int?
  headlineBasis Json // { counted: number, total: number }
  computedAt    DateTime @default(now())

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId])
}

model PerformanceImport {
  id           String   @id @default(cuid())
  userId       String
  platform     String // meta | tiktok
  filename     String
  rowsTotal    Int
  rowsMatched  Int
  rowsRejected Json // { line: number, reason: string }[]
  createdAt    DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows PerformanceRow[]

  @@index([userId])
}

model PerformanceRow {
  id          String   @id @default(cuid())
  importId    String
  creativeId  String?
  adName      String
  impressions Int
  clicks      Int
  spend       Decimal  @db.Decimal(10, 2)
  purchases   Int?
  revenue     Decimal? @db.Decimal(10, 2)
  matched     Boolean  @default(false)

  import   PerformanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  creative Creative?         @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([importId])
  @@index([creativeId])
}
