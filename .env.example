# Local (SQLite) — resolved from project root (directory is created if missing)
DATABASE_URL="file:./prisma/dev.db"

# Production / preview (Postgres)
# DATABASE_URL="postgresql://user:pass@host:5432/viralyz?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional HMAC secret for OAuth state cookies
OAUTH_STATE_SECRET="change-me-in-production"

# Async jobs — set REDIS_URL and run `npm run worker` for BullMQ
# Leave empty for in-process inline scoring (default local)
REDIS_URL=""
# REDIS_URL="redis://localhost:6379"

# Object storage — leave empty for local public/uploads/
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
# Example MinIO (docker compose):
# S3_BUCKET="viralyz"
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="viralyz"
# S3_SECRET_KEY="viralyzsecret"
# S3_PUBLIC_URL="http://localhost:9000/viralyz"

# Model-serving boundary — leave empty for local heuristic scorer
SCORING_SERVICE_URL=""
SCORING_SERVICE_TOKEN=""
# Expected: POST {SCORING_SERVICE_URL}/v1/score → ScoreOutput JSON

# Platform OAuth — when set, Connect platform runs real authorization code flow
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# Redirect URIs to register with each provider:
#   {NEXT_PUBLIC_APP_URL}/api/platforms/oauth/tiktok/callback
#   {NEXT_PUBLIC_APP_URL}/api/platforms/oauth/instagram/callback
#   {NEXT_PUBLIC_APP_URL}/api/platforms/oauth/youtube/callback
