# Postgres (required) — Neon / Docker / hosted
# docker compose: postgresql://viralyz:viralyz@localhost:5432/viralyz
DATABASE_URL="postgresql://user:pass@host:5432/viralyz?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Signing secrets (REQUIRED in production) ---
# The server refuses to boot in production if these are missing, short (<32 chars),
# or left at a placeholder value. Generate with: openssl rand -base64 48
#
# SESSION_SECRET signs the session cookie. Rotating it invalidates all sessions.
SESSION_SECRET=""
# OAUTH_STATE_SECRET signs the OAuth state parameter (CSRF protection on platform linking).
OAUTH_STATE_SECRET=""

# --- Scale / SSO (optional; app works without these) ---

# Clerk SSO — leave empty to keep email/password cookie auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Optional webhook signing secret
CLERK_WEBHOOK_SECRET=""

# Invite-only signup (default true). Set false for open signup.
INVITE_ONLY="true"

# Comma-separated admin emails. Empty by default — any address listed here is granted
# the admin role automatically on SSO sign-in, so keep this tight.
ADMIN_EMAILS=""

# One-click demo sign-in on the login page. Off unless explicitly enabled.
# The account must already exist (seed it) and must NOT have the admin role.
DEMO_LOGIN="false"
DEMO_LOGIN_EMAIL="demo@viralyz.com"

# Resend — leave empty to log emails to the server console
RESEND_API_KEY=""
RESEND_FROM="Viralyz <onboarding@resend.dev>"

# Async jobs — set REDIS_URL and run `npm run worker` for BullMQ
REDIS_URL=""

# Object storage — leave empty for local public/uploads/
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# Model-serving boundary — leave empty for local heuristic scorer
SCORING_SERVICE_URL=""
SCORING_SERVICE_TOKEN=""

# Platform OAuth — when set, Connect platform runs real authorization code flow
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
# Redirect URIs:
#   {NEXT_PUBLIC_APP_URL}/api/platforms/oauth/tiktok/callback
#   {NEXT_PUBLIC_APP_URL}/api/platforms/oauth/instagram/callback
#   {NEXT_PUBLIC_APP_URL}/api/platforms/oauth/youtube/callback
